# 管理员账号，首次启动会自动创建。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=infinite-canvas

# JWT 登录密钥和过期时间，正式部署请修改 JWT_SECRET。
JWT_SECRET=infinite-canvas
JWT_EXPIRE_HOURS=168

# 后端默认监听 8080，如需本地开发修改端口再取消注释。
# Docker 镜像内前端固定监听 3000，避免覆盖前端 PORT。
# PORT=8080

# 前端开发代理默认使用 http://127.0.0.1:8080，如后端开发端口不同，启动前端时可单独设置 API_BASE_URL。
# API_BASE_URL=http://127.0.0.1:8080

# 数据库配置，默认使用本地 SQLite。
STORAGE_DRIVER=sqlite
# sqlite: DATABASE_DSN=data/infinite-canvas.db
# Docker 部署时建议使用绝对路径，避免工作目录变化后写入临时库：DATABASE_DSN=/app/data/infinite-canvas.db
# mysql 目标库不存在时会尝试自动创建，账号需有 CREATE 权限。
# 后端会自动补齐 parseTime=true，未显式提供 loc 时默认 loc=Local；建议同时声明 charset=utf8mb4。
# mysql: DATABASE_DSN=user:password@tcp(127.0.0.1:3306)/infinite_canvas?parseTime=true&charset=utf8mb4&loc=Local
# postgres 目标库不存在时会尝试自动创建，账号需有 CREATEDB 权限。
# postgres: DATABASE_DSN=postgres://user:password@127.0.0.1:5432/infinite_canvas?sslmode=disable
DATABASE_DSN=data/infinite-canvas.db

# 发布图片本地目录。Docker 部署时位于挂载卷 /app/data 下，默认无需修改。
# PUBLISH_MEDIA_DIR=data/publish-media

# lx-pay 微信 Native 扫码支付。仅作为初始默认值：后台「系统设置 → 私有配置 → 微信支付」保存后以数据库配置为准。
# App ID、应用密钥、APIv3 密钥与回调地址在代码里已有内置默认值，这里留空即可；需要覆盖时再填写。
# 网关地址默认指向同机部署的 lx-pay 服务（http://127.0.0.1:8989），跨机部署时再覆盖。
LX_PAY_SERVER_URL=
LX_PAY_APP_ID=
LX_PAY_APP_SECRET=
LX_PAY_NOTIFY_URL=http://127.0.0.1:8080/api/payment/notify
LX_PAY_API_V3_KEY=
LX_PAY_PLATFORM_CERT_PATH=
LX_PAY_TIMEOUT_MS=10000
LX_PAY_MAX_RETRIES=3
RECHARGE_ORDER_MINUTES=15
